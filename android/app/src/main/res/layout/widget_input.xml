<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:gravity="center_vertical" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B9B2A6" android:textSize="11sp"
        android:letterSpacing="0.12" android:fontFamily="sans-serif-condensed" android:text="INPUT" />
    <TextView android:id="@+id/big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#F2EDE4"
        android:textSize="30sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:text="--" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
            <TextView android:id="@+id/is0" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/is1" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/is2" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/is3" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/is4" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/is5" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/is6" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/is7" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/is8" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#8A847A"
        android:textSize="12sp" android:fontFamily="sans-serif-condensed" android:text="Not linked" />
</LinearLayout>
