<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/num" android:layout_width="32dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/flip_blue"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:text="--" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/song" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F2EDE4" android:textSize="15sp"
                android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:text="Keystone" />
            <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B9B2A6" android:textSize="12sp"
                android:fontFamily="sans-serif-condensed" android:letterSpacing="0.08" android:maxLines="1" android:text="KEYSTONE" />
        </LinearLayout>
        <TextView android:id="@+id/linked" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8A847A" android:textSize="12sp"
            android:fontFamily="sans-serif-condensed" android:text="NOT LINKED" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <TextView android:id="@+id/chip0" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:background="@drawable/chip_off" android:textColor="#8A847A" android:textSize="11sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.06" android:maxLines="1" />
            <TextView android:id="@+id/chip1" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:background="@drawable/chip_off" android:textColor="#8A847A" android:textSize="11sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.06" android:maxLines="1" />
            <TextView android:id="@+id/chip2" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:background="@drawable/chip_off" android:textColor="#8A847A" android:textSize="11sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.06" android:maxLines="1" />
            <TextView android:id="@+id/chip3" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:background="@drawable/chip_off" android:textColor="#8A847A" android:textSize="11sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.06" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/chip4" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:background="@drawable/chip_off" android:textColor="#8A847A" android:textSize="11sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.06" android:maxLines="1" />
            <TextView android:id="@+id/chip5" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:background="@drawable/chip_off" android:textColor="#8A847A" android:textSize="11sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.06" android:maxLines="1" />
            <TextView android:id="@+id/chip6" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:background="@drawable/chip_off" android:textColor="#8A847A" android:textSize="11sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.06" android:maxLines="1" />
            <TextView android:id="@+id/chip7" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:background="@drawable/chip_off" android:textColor="#8A847A" android:textSize="11sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.06" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:id="@+id/inLabel" android:layout_width="48dp" android:layout_height="wrap_content" android:textColor="#B9B2A6" android:textSize="11sp" android:letterSpacing="0.1"
            android:fontFamily="sans-serif-condensed" android:text="INPUT" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/ws0" android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/ws1" android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/ws2" android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/ws3" android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/ws4" android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/ws5" android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/ws6" android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/ws7" android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/ws8" android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
            <TextView android:id="@+id/ws9" android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/seg_off" />
        </LinearLayout>
        <TextView android:id="@+id/inDb" android:layout_width="52dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#F2EDE4" android:textSize="12sp"
            android:fontFamily="sans-serif-condensed" android:text="-- dB" />
    </LinearLayout>
</LinearLayout>
